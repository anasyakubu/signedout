# --- Server (place a copy as server/.env) ---
PORT=4000
MONGODB_URI=mongodb://localhost:27017/signedout
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
CLIENT_URL=http://localhost:5173

# Google OAuth (optional in dev; the app runs without it, the Google button
# will return a clear "not configured" error until these are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Seeded admin account (created/promoted on server boot)
ADMIN_SEED_EMAIL=yakubuanas04@gmail.com
ADMIN_SEED_PASSWORD=

# --- Storage: leave AWS blank in dev and uploads go to server/uploads on
# disk, served at /uploads. Fill all four AWS values to switch to S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
CLOUDFRONT_DOMAIN=

# --- Payments: a gateway only activates when its secret key is present.
# Use test keys in dev (sk_test_... / FLWSECK_TEST-...).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "Secret hash" you set in the Flutterwave dashboard under
# Settings -> Webhooks. Flutterwave sends it verbatim in the verif-hash
# header; the server rejects webhooks that do not match it.
FLUTTERWAVE_WEBHOOK_HASH=
